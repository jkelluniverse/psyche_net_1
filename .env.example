# --- Database (Railway provides this automatically once Postgres is added) ---
DATABASE_URL="postgresql://user:password@host:port/dbname"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# --- Extraction proposer (AI) ---
# Server-side only; the key never reaches the browser. The proposer is the
# UNTRUSTED half of the pipeline — everything it returns passes through the
# deterministic citation gate (see /docs/citation-gate-spec.md).
ANTHROPIC_API_KEY="sk-ant-..."
